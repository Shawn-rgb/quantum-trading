# 复制为 config/.env 并填写真实值（config/.env 已被 .gitignore 忽略）

# Telegram Bot（phase4_telegram / phase5_crypto）
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# OpenAI（ear_training_game 也可使用项目根 config/.env）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Supabase（ear_training_game 答题记录，可选）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ClickHouse / Redis（phase5_crypto futures_ws_collector，可选）
REDIS_URL=redis://127.0.0.1:6379/0
CH_HOST=127.0.0.1
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=binance_futures

# 网络代理（WSL / 国内访问 Binance、yfinance）
# CRYPTO_PROXY_URL=http://127.0.0.1:7890
# CRYPTO_NO_PROXY=1
